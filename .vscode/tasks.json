{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Test all C++ solutions",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/cp.py", "test", "all"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CP: Differential stress tests",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/cp.py", "stress"],
      "problemMatcher": []
    },
    {
      "label": "CP: Check catalogue",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/cp.py", "check"],
      "problemMatcher": []
    }
  ]
}
